---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import NavPill from '../components/NavPill.astro';
import ContactDrawer from '../components/ContactDrawer.astro';
import { getLocale, t } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Pad of URL van de og:image. Standaard: public/og.png (1200x630). */
  image?: string;
  /** Afmetingen van `image`, als bekend. */
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  noindex = false,
  image = '/og.png',
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;
const locale = getLocale(Astro.currentLocale);
// `site` staat in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('site.name', locale)} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />
    <ClientRouter />
    <slot name="head" />
    <script>
      import '../scripts/view-transition.ts';
    </script>
  </head>
  <body>
    <slot />
    <NavPill />
    <ContactDrawer />
  </body>
</html>
