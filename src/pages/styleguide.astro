---
// Eigen <head> (geen BaseLayout): de layout heeft geen head-slot voor `noindex`.
import { Font } from 'astro:assets';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import Intro from '../components/Intro.astro';
import ScreenshotBlock from '../components/ScreenshotBlock.astro';
import testImage from '../assets/styleguide/screenshot.png';
import { getLocale, t } from '../i18n';
import '../styles/global.css';

const locale = getLocale(Astro.currentLocale);
const swatches = [
  ['ink', 'bg-ink text-paper'],
  ['paper', 'bg-paper text-ink border border-line'],
  ['muted', 'bg-muted text-paper'],
  ['panel', 'bg-panel'],
  ['pill', 'bg-pill'],
  ['line', 'bg-line'],
  ['rule', 'bg-rule'],
  ['faint', 'bg-faint'],
  ['ring', 'bg-ring text-paper'],
];
const icons: IconName[] = ['home', 'person', 'send', 'mail', 'close'];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Styleguide</title>
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />
  </head>
  <body>
    <main class="flex flex-col gap-16 p-4">
      <section class="flex flex-col gap-8">
        <h2 class="text-micro text-muted">Typografie</h2>
        <h1 class="text-title-xl">{t('site.name', locale)}</h1>
        <p class="text-title-lg">{t('site.role', locale)}</p>
        <p class="text-title-md">{t('cta.contact', locale)}</p>
        <p class="text-heading">{t('site.name', locale)}</p>
        <p class="text-body">{t('contact.mail.body', locale)}</p>
        <p class="text-label font-semibold">
          {t('contact.mail.label', locale)}
        </p>
        <p class="text-micro text-muted">{t('chapters.label', locale)}</p>
        <ul class="flex flex-wrap gap-2">
          {swatches.map(([name, cls]) => (
            <li class={`text-label rounded-lg px-3 py-6 ${cls}`}>{name}</li>
          ))}
        </ul>
        <div class="bg-panel shadow-shot h-24 w-64 rounded-lg"></div>
        <div class="shadow-pill bg-pill w-fit rounded-full px-4 py-2">
          {t('nav.home', locale)}
        </div>
      </section>

      <section class="flex flex-col gap-6">
        <h2 class="text-micro text-muted">Knoppen</h2>
        <div class="flex flex-wrap items-center gap-4">
          <Button variant="primary" icon="send" data-open-contact>
            {t('cta.contact', locale)}
          </Button>
          <Button variant="primary" href="#">
            Primair link
          </Button>
          <Button variant="primary">Primair zonder icoon</Button>
          <Button variant="secondary" icon="person" decorative>
            {t('cta.expertise', locale)}
          </Button>
          <Button variant="secondary" href="#" icon="person">
            Secundair link
          </Button>
          <Button variant="secondary">Secundair button</Button>
        </div>
      </section>

      <section class="flex flex-col gap-6">
        <h2 class="text-micro text-muted">
          Iconen (16, 12 en 20 voor sluiten)
        </h2>
        <div class="text-muted flex items-center gap-6">
          {icons.map((name) => (
            <Icon name={name} size={name === 'close' ? 20 : 16} />
          ))}
        </div>
        <div class="text-ink flex items-center gap-6">
          {icons.map((name) => (
            <Icon name={name} size={12} />
          ))}
        </div>
      </section>

      <section class="flex flex-col gap-6">
        <h2 class="text-micro text-muted">Avatar</h2>
        <Avatar />
      </section>

      <section class="flex flex-col gap-6">
        <h2 class="text-micro text-muted">Intro</h2>
        <div class="flex flex-wrap gap-16">
          <Intro align="start" />
          <Intro align="center" />
        </div>
      </section>

      <section class="flex flex-col gap-6">
        <h2 class="text-micro text-muted">
          ScreenshotBlock (5:3, 1026 breed, radius 16)
        </h2>
        <div class="flex flex-col gap-8">
          <ScreenshotBlock
            image={testImage}
            alt="Testscreenshot, contained, inset block"
            inset="block"
            class="aspect-[5/3] w-full max-w-[1026px] rounded-2xl"
          />
          <ScreenshotBlock
            image={testImage}
            alt="Testscreenshot, full-bleed"
            fit="full-bleed"
            class="aspect-[5/3] w-full max-w-[1026px] rounded-2xl"
          />
        </div>
        <h2 class="text-micro text-muted">
          ScreenshotBlock in een paneel (720 breed)
        </h2>
        <ScreenshotBlock
          image={testImage}
          alt="Testscreenshot, contained, inset panel"
          color="#d9e4f2"
          inset="panel"
          class="aspect-[5/3] w-full max-w-[720px] rounded-2xl"
        />
      </section>
    </main>
  </body>
</html>
