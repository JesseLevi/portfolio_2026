---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackButton from '../../components/case/BackButton.astro';
import CaseHeader from '../../components/case/CaseHeader.astro';
import CaseBlock from '../../components/case/CaseBlock.astro';
import ChapterNav from '../../components/case/ChapterNav.astro';
import CaseFooter from '../../components/case/CaseFooter.astro';
import { paragraphs } from '../../components/case/paragraphs';
import { getCases } from '../../lib/cases';
import { getLocale, t } from '../../i18n';

export const getStaticPaths = (async () => {
  const cases = await getCases('nl');
  return cases.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const { title, work, blocks, hero } = entry.data;
// De hero is een png met schaduw (alpha): jpg zou zwart worden, dus png.
const og = await getImage({ src: hero.image, width: 1200, format: 'png' });

// De header telt mee als de eerste twee hoofdstukken: het openingsbeeld en de opdracht.
const header = { opening: 'opening', brief: 'opdracht' };
const headerChapters = [
  { id: header.opening, name: t('chapters.opening', locale) },
  { id: header.brief, name: t('chapters.brief', locale) },
];

// Anker per blok: slug van de hoofdstuknaam, uniek gemaakt met een teller.
const used = new Set<string>(Object.values(header));
const ids = blocks.map((block) => {
  const base =
    block.chapter
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'hoofdstuk';
  let id = base;
  for (let n = 2; used.has(id); n++) id = `${base}-${n}`;
  used.add(id);
  return id;
});
---

<BaseLayout
  title={`${title} | ${t('site.name', locale)}`}
  description={paragraphs(work)[0] ?? title}
  image={og.src}
  imageWidth={og.attributes.width}
  imageHeight={og.attributes.height}
>
  <main>
    <BackButton />
    <article class="mx-auto max-w-[calc(1026px+2rem)] px-4">
      <CaseHeader entry={entry} ids={header} />
      <div class="mt-[72px] flex flex-col gap-[72px] md:mt-[104px] md:gap-[104px]">
        {blocks.map((block, i) => (
          <CaseBlock block={block} id={ids[i]!} />
        ))}
      </div>
    </article>
  </main>
  <ChapterNav
    visibleFrom={header.brief}
    chapters={[
      ...headerChapters,
      ...blocks.map((block, i) => ({ id: ids[i]!, name: block.chapter })),
    ]}
  />
  <CaseFooter />
</BaseLayout>
