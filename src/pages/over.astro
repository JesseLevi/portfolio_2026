---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import Button from '../components/Button.astro';
import ChapterNav from '../components/case/ChapterNav.astro';
import ServiceCard from '../components/about/ServiceCard.astro';
import WorkCard from '../components/about/WorkCard.astro';
import contact from '../assets/contact/illustration.svg';
import contactStatic from '../assets/contact/illustration-static.svg';
import { getAbout } from '../lib/about';
import { getCases } from '../lib/cases';
import { siteConfig } from '../config';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const { status, title, subtitle, clients, services, process, work, closing } =
  await getAbout(locale);
const cases = new Map((await getCases(locale)).map((c) => [c.data.slug, c]));

// Hoofdstukken: dezelfde indicator als op de case-pagina (vanaf `lg`).
const ids = {
  intro: 'intro',
  services: 'diensten',
  process: 'werkwijze',
  work: 'werk',
  contact: 'contact',
} as const;
const chapters = (Object.keys(ids) as (keyof typeof ids)[]).map((key) => ({
  id: ids[key],
  name: t(`about.chapter.${key}`, locale),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t('site.name', locale),
  jobTitle: t('site.role', locale),
  url: new URL('/over', Astro.site).href,
  email: `mailto:${siteConfig.email}`,
  sameAs: [siteConfig.linkedin],
  knowsAbout: services.items.map((s) => s.title),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: services.title,
    itemListElement: services.items.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.body },
    })),
  },
};

// Entree: alles t/m de fold komt bij het laden één voor één binnen (zie <style>).
const enter = (i: number) => `--i: ${i}`;

// Sectiekoppen: 28px mobiel, 48px vanaf `md`.
const h2 = 'text-title-xs md:text-title-md leading-[1.1]';
const section = 'mt-28 scroll-mt-12 md:mt-40';
const container = 'mx-auto max-w-[calc(1026px+2rem)] px-4';
---

<BaseLayout
  title={t('about.title', locale)}
  description={t('about.description', locale)}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <main class="pb-40">
    <div class={container}>
      <!-- Intro: status, belofte, knoppen en de klanten als bewijs. -->
      <section
        id={ids.intro}
        aria-labelledby="over-titel"
        class="flex flex-col items-center pt-16 text-center md:pt-28"
      >
        <div
          style={enter(0)}
          class="enter bg-paper shadow-pill text-label flex h-9 items-center gap-2 rounded-full pr-4 pl-1.5"
        >
          <Avatar size={24} />
          <span class="relative flex size-2" aria-hidden="true">
            <span class="bg-available absolute inset-0 animate-ping rounded-full opacity-60"></span>
            <span class="bg-available relative size-2 rounded-full"></span>
          </span>
          {status}
        </div>

        <h1
          id="over-titel"
          class="text-title-sm md:text-title-lg mt-8 max-w-[880px] leading-[1.1] text-balance"
        >
          <span class="enter" style={enter(1)}>
            {title}
          </span>{' '}
          <span style={enter(2)} class="enter text-muted">
            {subtitle}
          </span>
        </h1>

        <div
          style={enter(3)}
          class="enter mt-10 flex flex-wrap justify-center gap-4"
        >
          <Button variant="primary" icon="send" data-open-contact>
            {t('cta.contact', locale)}
          </Button>
          <Button variant="secondary" icon="arrow-right" href="/">
            {t('about.work', locale)}
          </Button>
        </div>

        <div class="mt-20 md:mt-24">
          <p style={enter(4)} class="enter text-body text-muted">
            {clients.label}
          </p>
          <ul class="text-heading mt-4 flex flex-wrap justify-center gap-x-8 gap-y-2">
            {clients.items.map(({ name, case: slug }, i) => (
              <li class="enter" style={enter(5 + i)}>
                {slug ? (
                  <a
                    href={`/werk/${slug}`}
                    class="text-muted hover:text-ink focus-visible:outline-ink rounded-sm transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4"
                  >
                    {name}
                  </a>
                ) : (
                  <span class="text-muted">{name}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Diensten: elk met een levend UI-fragment (src/scripts/demos.ts). -->
      <section
        id={ids.services}
        aria-labelledby="diensten-titel"
        class={section}
      >
        <h2
          id="diensten-titel"
          style={enter(5 + clients.items.length)}
          class:list={[h2, 'enter text-center']}
        >
          {services.title}
        </h2>
        <ul class="mt-10 grid gap-y-16 md:mt-14 lg:grid-cols-3 lg:gap-x-2 lg:gap-y-0">
          {services.items.map((service) => (
            <ServiceCard service={service} />
          ))}
        </ul>
      </section>

      <section
        id={ids.process}
        aria-labelledby="werkwijze-titel"
        class={section}
      >
        <h2 id="werkwijze-titel" class:list={[h2, 'text-center']}>
          {process.title}
        </h2>
        <ol class="mt-10 grid grid-cols-2 gap-x-2 gap-y-10 md:mt-14 lg:grid-cols-4">
          {process.steps.map((step, i) => (
            <li class="border-rule border-t px-1 pt-4">
              <span
                class="text-body text-muted tabular-nums"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-heading mt-6">{step.title}</h3>
              <p class="text-body text-muted mt-2">{step.body}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <!-- Werk: kaarten naar de cases, breder dan de container (max 1312, zodat de hoofdstuk-indicator op 1440 vrij blijft). Passen ze niet, dan veeg je. -->
    <section id={ids.work} aria-labelledby="werk-titel" class={section}>
      <h2 id="werk-titel" class:list={[h2, 'px-4 text-center']}>
        {work.title}
      </h2>
      <ul class="mx-auto mt-10 flex max-w-[1312px] snap-x snap-mandatory scroll-px-4 gap-2 overflow-x-auto px-4 [justify-content:safe_center] [scrollbar-width:none] md:mt-14">
        {work.items.map((item) => (
          <WorkCard entry={cases.get(item.case)!} item={item} />
        ))}
      </ul>
      <div class="mt-10 flex justify-center px-4">
        <Button variant="secondary" icon="arrow-right" href="/">
          {work.cta}
        </Button>
      </div>
    </section>

    <div class={container}>
      <!-- Slot: de contactillustratie (de lege kruk) is de uitnodiging. -->
      <section
        id={ids.contact}
        aria-labelledby="contact-titel"
        class:list={[section, 'flex flex-col items-center text-center']}
      >
        <!-- <img> en lazy: de animatie begint pas als hij geladen wordt, dus vlak voor hij in beeld komt. -->
        <picture>
          <source
            media="(prefers-reduced-motion: reduce)"
            srcset={contactStatic.src}
          />
          <img
            src={contact.src}
            width={contact.width}
            height={contact.height}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-auto w-[260px] md:w-[340px]"
          />
        </picture>
        <h2 id="contact-titel" class:list={[h2, 'mt-8']}>
          {closing.title}
        </h2>
        <p class="text-body text-muted mt-3">{closing.body}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <Button href={`mailto:${siteConfig.email}`} icon="mail">
            {t('contact.mail.cta', locale)}
          </Button>
          <Button
            variant="secondary"
            href={siteConfig.linkedin}
            icon="send"
            target="_blank"
            rel="noopener"
          >
            {t('contact.linkedin.cta', locale)}
          </Button>
        </div>
      </section>
    </div>
  </main>

  <ChapterNav chapters={chapters} visibleFrom={ids.services} />
</BaseLayout>

<script>
  import '../scripts/demos.ts';
</script>

<style>
  /*
   * Entree bij het laden: de elementen t/m de fold komen één voor één binnen (omhoog, uit
   * de blur). Puur CSS, dus geen flits vóór het script; ook na een navigatie naar deze
   * pagina. De woorden van de kop zijn inline: die krijgen alleen de fade en de blur.
   */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: enter 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }
  }
  @keyframes enter {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(16px);
    }
  }
</style>
