---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
---

<BaseLayout title={t('site.name', locale)} description={t('site.role', locale)}>
  <!-- Placeholder: de echte Home komt in een later ticket. Bouwstenen: /styleguide. -->
  <main class="p-4">
    <h1 class="text-heading">{t('site.name', locale)}</h1>
  </main>
</BaseLayout>
