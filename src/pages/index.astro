---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import CaseList from '../components/home/CaseList.astro';
import CasePanel from '../components/home/CasePanel.astro';
import { getCases } from '../lib/cases';
import { getLocale, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const cases = await getCases(locale);
---

<BaseLayout
  title={t('home.title', locale)}
  description={t('home.description', locale)}
>
  <!--
    Linkerkolom = documentscroll met scroll-snap per titel (html[data-home-snap],
    gezet door home-scroll.ts); paneel = sticky (desktop) of vast onderin (mobiel).
    Snaplijn = introhoogte (--intro-h, gemeten). De onderruimte laat ook de
    laatste titel die lijn bereiken (--last-h = hoogte van het laatste item);
    lvh, want op iOS is de viewport met ingeklapte balken zo hoog. In
    lus-modus (#14, html[data-home-loop]) vervalt die ruimte: de kopie van intro
    + lijst achter de lijst (home-scroll.ts) levert haar.
  -->
  <main class="grid [--panel-h:min(400px,46lvh)] lg:grid-cols-2">
    <h1 class="sr-only">{t('home.title', locale)}</h1>
    <div
      data-home-col
      class="px-6 pb-[max(0px,calc(100lvh-var(--intro-h,0px)-var(--last-h,0px)))] lg:mx-auto lg:w-max lg:max-w-full"
    >
      <div data-home-intro>
        <Intro
          align="start"
          class="pt-6 pb-12 lg:h-100 lg:justify-center lg:py-0"
        />
      </div>
      <CaseList cases={cases} label={t('home.cases', locale)} />
    </div>
    <CasePanel cases={cases} />
  </main>
</BaseLayout>

<script>
  import '../scripts/home-scroll.ts';
</script>

<style is:global>
  html[data-home-loop] [data-home-col] {
    padding-bottom: 0;
  }

  /*
   * Slot tijdens de sprong van de lus (home-scroll.ts): geen gebruikersscroll,
   * scrollTo werkt wel. De vaste goot voorkomt dat klassieke scrollbalken de
   * layout laten verspringen als ze even wegvallen.
   */
  html[data-home-loop] {
    scrollbar-gutter: stable;
  }
  html[data-home-loop-lock] {
    overflow: hidden;
  }

  /*
   * Mobiel: boven de kopie-intro horen geen titels. Het witte vlak boven de
   * kopie (home-scroll.ts) vervaagt in zodra de laatste titel de snaplijn
   * verlaat, en dekt alles af als de kopie-intro hem bereikt (één titelhoogte
   * later). Een scrollanimatie, geen JS: die loopt in iOS Safari synchroon met
   * het scrollen. De kopie is minstens een viewport hoog, dus `entry 100%` is
   * het moment dat haar bovenkant de bovenrand van het scherm raakt, en
   * `entry calc(100% - X)` het moment dat ze X onder de bovenrand staat.
   * Zonder ondersteuning blijven de titels gewoon staan.
   */
  [data-home-loop-veil] {
    display: none;
  }
  @supports (animation-range: entry calc(100% - 1px)) {
    @media (max-width: 1023px) {
      [data-home-loop-clone] {
        position: relative;
        view-timeline-name: --home-clone;
        view-timeline-axis: block;
      }
      [data-home-loop-veil] {
        display: block;
        position: absolute;
        inset-inline: -1.5rem; /* over de gutter (px-6) heen */
        bottom: 100%;
        height: 100lvh;
        background-color: var(--color-paper);
        pointer-events: none;
        /* Longhands: de minifier vouwt `animation` + `animation-timeline` anders
           samen tot één shorthand, en die slaan browsers over. */
        animation-name: home-veil;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --home-clone;
        animation-range: entry
          calc(100% - var(--intro-h, 0px) - var(--last-h, 0px)) entry
          calc(100% - var(--intro-h, 0px));
      }
    }
  }
  @keyframes home-veil {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Snap alleen met bewegingsvoorkeur; bij reduced motion scrolt de pagina vrij. */
  @media (prefers-reduced-motion: no-preference) {
    html[data-home-snap] {
      scroll-snap-type: y mandatory;
    }
  }
</style>
