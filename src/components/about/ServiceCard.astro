---
// Dienst op de pagina "Over": een gekleurd blok met een levend UI-fragment, dan titel,
// één zin en wat je krijgt. Het blok volgt de case-pagina: 5:3 tot `lg`, daarna 4:5.
import '../../styles/demos.css';
import ProductDemo from './demos/ProductDemo.astro';
import WebDemo from './demos/WebDemo.astro';
import BrandDemo from './demos/BrandDemo.astro';
import type { Service } from '../../lib/about';
import { getLocale, t } from '../../i18n';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const Demo = { product: ProductDemo, web: WebDemo, brand: BrandDemo }[
  service.demo
];
---

<!-- Subgrid vanaf `lg`: blok, tekst en lijst lopen over de drie kaarten gelijk. Titel en zin zijn één rij, zodat een titel van twee regels alleen de lijsten (met hun bovenlijn) laat zakken. -->
<li class="grid content-start lg:row-span-3 lg:grid-rows-subgrid">
  <div
    data-demo-stage
    aria-hidden="true"
    class="demo-stage flex aspect-5/3 items-center justify-center overflow-hidden rounded-lg md:rounded-2xl lg:aspect-4/5"
    style={{ backgroundColor: service.color }}
  >
    <Demo />
  </div>
  <div class="mt-6 px-1">
    <h3 class="text-heading">{service.title}</h3>
    <p class="text-body text-muted mt-2">{service.body}</p>
  </div>
  <ul
    aria-label={t('about.deliverables', locale)}
    class="text-body border-rule mx-1 mt-6 self-start border-t"
  >
    {service.deliverables.map((item) => (
      <li class="border-rule border-b py-2.5">{item}</li>
    ))}
  </ul>
</li>
