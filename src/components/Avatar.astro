---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- 62px. Ring (inside), witte achtergrond en inner shadows uit Figma 6164:23211. -->
<div
  class:list={[
    'bg-paper relative size-[62px] shrink-0 overflow-hidden rounded-full shadow-[inset_0_2px_10px_-4px_rgb(0_0_0/.25),inset_0_3px_4px_-5px_rgb(0_0_0/.25)]',
    className,
  ]}
>
  <Image
    src={avatar}
    alt=""
    width={48}
    height={48}
    densities={[2, 4]}
    class="absolute top-[7px] left-[7px] size-12"
  />
  <span class="bg-ink absolute top-[55px] left-[17px] h-2.5 w-[33px]"></span>
  <span class="ring-ring pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset"></span>
</div>
