---
// Getraceerd uit avatar.png met scripts/illustrations (die PNG blijft de bron, ook voor de OG-afbeelding).
// De animatie (rondkijken, knipperen) zit in de SVG zelf; bij reduced motion de stilstaande variant.
import avatar from '../assets/avatar.svg';
import avatarStatic from '../assets/avatar-static.svg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- 62px; de afbeelding vult de hele cirkel en het shirt loopt erin door tot de onderrand. Ring (inside), witte achtergrond en inner shadows uit Figma 6164:23211. -->
<div
  class:list={[
    'bg-paper relative size-[62px] shrink-0 overflow-hidden rounded-full',
    className,
  ]}
>
  <picture class="contents">
    <source
      media="(prefers-reduced-motion: reduce)"
      srcset={avatarStatic.src}
    />
    <img
      src={avatar.src}
      alt=""
      width="62"
      height="62"
      class="absolute inset-0 size-full"
    />
  </picture>
  <span class="ring-ring pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset shadow-[inset_0_2px_10px_-4px_rgb(0_0_0/.25),inset_0_3px_4px_-5px_rgb(0_0_0/.25)]"></span>
</div>
