---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- PNG i.p.v. webp: lossy webp maakt het wit #fefefe, waardoor de afbeelding als blok zichtbaar wordt. 62px; de afbeelding vult de hele cirkel en het shirt loopt erin door tot de onderrand. Ring (inside), witte achtergrond en inner shadows uit Figma 6164:23211. -->
<div
  class:list={[
    'bg-paper relative size-[62px] shrink-0 overflow-hidden rounded-full',
    className,
  ]}
>
  <Image
    src={avatar}
    alt=""
    width={62}
    height={62}
    densities={[2, 4]}
    format="png"
    class="absolute inset-0 size-full"
  />
  <span class="ring-ring pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset shadow-[inset_0_2px_10px_-4px_rgb(0_0_0/.25),inset_0_3px_4px_-5px_rgb(0_0_0/.25)]"></span>
</div>
