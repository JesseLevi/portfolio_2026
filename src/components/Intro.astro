---
import Avatar from './Avatar.astro';
import Button from './Button.astro';
import { getLocale, t } from '../i18n';

interface Props {
  align?: 'start' | 'center';
  class?: string;
}

const { align = 'start', class: className } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const centered = align === 'center';
---

<div
  class:list={[
    'flex flex-col gap-4',
    centered ? 'items-center text-center' : 'items-start',
    className,
  ]}
>
  <Avatar />
  <div
    class:list={[
      'flex flex-col gap-6',
      centered ? 'items-center' : 'items-start',
    ]}
  >
    <div class="text-heading flex flex-col gap-1.5">
      <p>{t('site.name', locale)}</p>
      <!-- Figma (402): de rol is 359 breed in 354 ruimte en steekt in de gutter; Safari zet Inter iets breder, dus de hele gutter (-me-6), anders breekt hij af. -->
      <p class:list={['text-muted', !centered && '-me-6']}>
        {t('site.role', locale)}
      </p>
    </div>
    <div class="flex gap-4">
      <Button variant="primary" icon="send" data-open-contact>
        {t('cta.contact', locale)}
      </Button>
      {!centered && (
        <Button variant="secondary" icon="person" href="/over#diensten">
          {t('cta.expertise', locale)}
        </Button>
      )}
    </div>
  </div>
</div>
