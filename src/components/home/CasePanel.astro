---
import ScreenshotBlock from '../ScreenshotBlock.astro';
import type { CaseEntry } from '../../lib/cases';

interface Props {
  cases: CaseEntry[];
}

const { cases } = Astro.props;
const first = cases[0];
---

<!--
  Paneel rechts (desktop, sticky 100vh) of vast onderin (mobiel). Alle hero's
  liggen gestapeld; alleen de actieve is zichtbaar (opacity, zodat #8 kan
  crossfaden). De kleur komt uit --panel-color; #8 zet die uit data-color.
  Elke link heeft zelf de kleur van zijn case: die is het gedeelde blok in de
  overgang naar de case (#13; view-transition-name staat alleen op het actieve
  item, gezet door home-scroll.ts). De titel in de lijst is het toetsenbordpad: deze links staan uit de tabvolgorde.
  Mobiel: het paneel hangt aan de onderkant van 100lvh (de fold), dus ook achter
  de werkbalk van iOS Safari. De afbeelding centreert in het deel dat ook met
  uitgeklapte werkbalk zichtbaar is (minus 100lvh - 100svh). Bewust geen dvh:
  iOS werkt dvh pas na het scrollen bij, en dan verspringt de afbeelding
  na elke veeg en legt Safari de snap opnieuw.
-->
<aside
  class="fixed inset-x-0 top-[calc(100lvh-var(--panel-h))] z-10 h-(--panel-h) bg-(--panel-color) transition-colors lg:sticky lg:inset-x-auto lg:top-0 lg:z-auto lg:h-svh lg:self-start"
  style={{ '--panel-color': first?.data.hero.color }}
  data-case-panel
>
  <div class="relative h-[calc(100%-(100lvh-100svh))] w-full lg:h-full">
    {cases.map((c, i) => (
      <a
        href={`/werk/${c.data.slug}`}
        tabindex="-1"
        aria-hidden={i === 0 ? undefined : 'true'}
        class="absolute inset-0 block pointer-events-none opacity-0 transition-opacity duration-300 data-active:pointer-events-auto data-active:opacity-100"
        data-case={c.data.slug}
        data-index={i}
        data-color={c.data.hero.color}
        data-active={i === 0 ? '' : undefined}
        style={{ backgroundColor: c.data.hero.color }}
      >
        <ScreenshotBlock
          image={c.data.hero.image}
          alt={c.data.hero.alt}
          color="transparent"
          inset="panel"
          priority={i === 0}
          class="size-full"
        />
      </a>
    ))}
  </div>
</aside>
