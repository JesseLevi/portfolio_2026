---
// Stroke-iconen uit Figma (viewBox 16, sluiten 20). Kleur via `currentColor`.
export type IconName = 'home' | 'person' | 'send' | 'mail' | 'close';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const viewBox = name === 'close' ? 20 : 16;
const strokeWidth = name === 'close' ? 1.66667 : 1.33333;
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${viewBox} ${viewBox}`}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
